# Same Convex deployment as android-native-rebuild. Never put an OpenAI key in VITE_*.
VITE_CONVEX_URL=
# HTTPS site origin or full /credit-agent endpoint. Falls back to VITE_CONVEX_URL's .convex.site origin.
VITE_CREDIT_AGENT_ENDPOINT=
# Optional public Firebase web overrides; defaults reuse the checked-in Android project's public config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=credit-repair-ai-v2.firebaseapp.com
# Server-side Convex environment: exact web origins, comma separated; no wildcard.
# CREDIT_WEB_ORIGINS=https://your-web-domain.example
